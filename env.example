BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_SENDER_EMAIL=contact@gdgmarseille.fr
CONTACT_TO_EMAIL=contact@gdgmarseille.fr
PARTNER_TO_EMAIL=contact@gdgmarseille.fr
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CRON_SECRET=
# First verify a dry-run, then select live to remove expired list memberships.
RETENTION_MODE=dry-run
