{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": [
    "cdg1"
  ],
  "functions": {
    "api/config.js": {
      "maxDuration": 60
    },
    "api/events.js": {
      "maxDuration": 60,
      "includeFiles": "public/data/events.json"
    },
    "api/retention.js": {
      "maxDuration": 60
    },
    "api/submit.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/retention",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
