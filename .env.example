# Configure these in Vercel > Project > Settings > Environment Variables.
# Never put private keys in public/ or commit a populated .env file.
# Doit être le domaine exact où le site s'affiche. gdgmarseille.fr redirige vers www.gdgmarseille.fr,
# donc utiliser la version www (sinon le contrôle de sécurité et l'origine du formulaire échouent).
SITE_URL=https://www.gdgmarseille.fr
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_SENDER_EMAIL=contact@gdgmarseille.fr
CONTACT_TO_EMAIL=contact@gdgmarseille.fr
PARTNER_TO_EMAIL=contact@gdgmarseille.fr
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
